<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.ghostmap</groupId>
    <artifactId>ghost-map</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ghostmap-core</artifactId>
  <description>Analysis layers, join policy, cards, and reports.</description>

  <properties>
    <tree-sitter.version>0.26.6</tree-sitter.version>
    <tree-sitter-java.version>0.23.5</tree-sitter-java.version>
    <asm.version>9.11.1</asm.version>
    <lombok.version>1.18.48</lombok.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.ghostmap</groupId>
      <artifactId>ghostmap-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- MIT-licensed tree-sitter-ng bundles native runtimes for deterministic CI parsing. -->
    <dependency>
      <groupId>io.github.bonede</groupId>
      <artifactId>tree-sitter</artifactId>
      <version>${tree-sitter.version}</version>
    </dependency>
    <!-- MIT-licensed official Java grammar packaged for tree-sitter-ng. -->
    <dependency>
      <groupId>io.github.bonede</groupId>
      <artifactId>tree-sitter-java</artifactId>
      <version>${tree-sitter-java.version}</version>
      <exclusions>
        <exclusion>
          <groupId>io.github.bonede</groupId>
          <artifactId>tree-sitter</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- BSD-3-Clause ASM reads class files directly without loading target classes. -->
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>${asm.version}</version>
    </dependency>
    <!-- MIT-licensed Lombok is test-only for generated-member bytecode fixtures. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
